    // دالة لتجاوز Angular ControlValueAccessor وتحديث قيمة الـ Input برمجياً
    function setAngularInputValue(element, val) {
        const prototype = Object.getPrototypeOf(element);
        const prototypeValueSetter = Object.getOwnPropertyDescriptor(prototype, 'value')?.set;
    
        if (prototypeValueSetter) {
            prototypeValueSetter.call(element, val);
        } else {
            element.value = val;
        }
    
        element.dispatchEvent(new Event('input', { bubbles: true }));
        element.dispatchEvent(new Event('change', { bubbles: true }));
    }
    
    window.autoContinueTimer = setInterval(() => {
        const textarea = document.querySelector('textarea.query-box-input, textarea[aria-label="Query box"]');
        const submitBtn = document.querySelector('button.submit-button, button[aria-label="Submit"]');
    
        if (!textarea || !submitBtn) {
            console.warn("⚠️ عناصر الواجهة غير متاحة حالياً، محاولة قادمة بعد دقيقتين...");
            return;
        }
    
        // 1. التأكد أن الموديل انتهى من الكتابة (عدم وجود زر Stop أو أيقونة stop)
        const isStillGenerating = document.querySelector('mat-icon[data-mat-icon-name="stop"]') !== null ||
                                  submitBtn.getAttribute('aria-label')?.toLowerCase().includes('stop') ||
                                  document.querySelector('.stop-button') !== null;
    
        if (isStillGenerating) {
            console.log("⏳ NotebookLM لا يزال يقوم بتوليد المحتوى...");
            return;
        }
    
        // 2. التحقق من ظهور جملة انتهاء الدرس
        const pageText = document.body.innerText;
        const isLessonCompleted = pageText.includes("Awaiting 'Continue'") ||
                                  pageText.includes("Completed.") ||
                                  pageText.slice(-300).toLowerCase().includes("continue");
    
        if (!isLessonCompleted) {
            console.log("🔍 بانتظار اكتمال رد الدرس الحالي...");
            return;
        }
    
        // 3. حقن كلمة Continue أولاً لتفعيل الزرار في Angular
        currentIteration++;
        console.log(`%c⚡ تم اكتمال الدرس! جاري إرسال Continue (${currentIteration} من أصل ${maxIterations})...`, "color: #00bfff; font-weight: bold;");
    
        textarea.focus();
        setAngularInputValue(textarea, 'Continue');
    
        // 4. الانتظار 350ms ليتعرف Angular على القيمة ويفك تعطيل الزر ثم الضغط
        setTimeout(() => {
            // ضغط الزرار
            submitBtn.click();
    
            // إرسال حدث مفتاح Enter كإجراء احتياطي إضافي
            const enterEvent = new KeyboardEvent('keydown', {
                key: 'Enter',
                code: 'Enter',
                keyCode: 13,
                which: 13,
                bubbles: true,
                cancelable: true
            });
            textarea.dispatchEvent(enterEvent);
    
            console.log("✅ تم إرسال الأمر بنجاح.");
    
            if (currentIteration >= maxIterations) {
                clearInterval(window.autoContinueTimer);
                console.log("%c🎉 انتهت الـ 17 درساً بالكامل! توقف السكربت تلقائياً.", "color: #ff00ff; font-weight: bold; font-size: 15px;");
            }
        }, 350);
    
    }, checkIntervalMs);
